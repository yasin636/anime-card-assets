{
  "expo": {
    "name": "AniGooD",
    "slug": "anime-meta-hub",
    "version": "0.22.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.yasin636.animemetahub",
      "versionCode": 36,
      "adaptiveIcon": {
        "backgroundColor": "#030014",
        "foregroundImage": "./assets/brand/adaptive-icon.png"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "com.yasin636.animemetahub",
      "supportsTablet": true
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "enabled": false
    },
    "plugins": [
      "expo-font",
      "expo-build-properties"
    ],
    "scheme": "animemetahub",
    "icon": "./assets/brand/icon.png",
    "splash": {
      "image": "./assets/brand/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#030014"
    }
  }
}
