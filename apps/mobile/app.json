{
  "expo": {
    "name": "Anime Meta Hub Test",
    "slug": "anime-meta-hub",
    "version": "0.6.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.yasin636.animemetahub",
      "versionCode": 13,
      "adaptiveIcon": {
        "backgroundColor": "#030014"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "com.yasin636.animemetahub",
      "supportsTablet": true
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "enabled": false
    },
    "plugins": [
      "expo-font",
      "expo-build-properties"
    ]
  }
}
